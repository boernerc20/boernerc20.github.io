---
const specs = [
  { k: 'ROLE', v: 'Electrical Engineer · Space Systems' },
  { k: 'CLEARANCE', v: 'Active DoD Top Secret' },
  { k: 'EDUCATION', v: 'M.Eng Computer Engineering · Virginia Tech' },
  { k: 'LOCATION', v: 'Washington, DC – Baltimore area' },
];
---
<section class="section" id="about">
  <div class="container">
    <div class="sec-head">
      <span class="silk desig">01</span>
      <h2 class="sec-title">About</h2>
    </div>

    <div class="about-grid">
      <div class="about-body reveal">
        <p>
          I'm a Computer Engineering Master's graduate from Virginia Tech, now working as an
          Electrical Engineer at <strong>Northrop Grumman</strong> on space systems. My focus is the
          avionics on <strong>ESPASat-L</strong> space vehicles — the vehicles that dispense from
          the <strong>ESPAStar</strong> satellite bus, each carrying a unique mission payload — and
          how the avionics boxes connect to the components across the vehicle.
        </p>
        <p>
          My background spans embedded systems, circuit design, hardware bring-up and validation,
          sensor integration, and low-level firmware — from RISC-V computer-architecture research to
          smart-home energy systems in France. Off the clock, I'm still on the bench: designing boards
          in KiCad, running a distributed homelab, flying and filming FPV drones, and chasing new
          places around the globe.
        </p>

        <dl class="specs">
          {specs.map((s) => (
            <div class="spec-row">
              <dt class="mono">{s.k}</dt>
              <dd>{s.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="about-photo reveal">
        <div class="photo-frame">
          <img src="/headshot.jpg" alt="Christopher Boerner" width="440" height="440" loading="lazy" decoding="async" />
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .about-body p {
    color: var(--text-dim);
    font-size: var(--fs-md);
    margin-bottom: 1.1rem;
    max-width: 60ch;
  }
  .about-body strong { color: var(--text); font-weight: 600; }

  .specs {
    margin-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .spec-row {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  .spec-row dt {
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    color: var(--text-mut);
    padding-top: 2px;
  }
  .spec-row dd { color: var(--text); font-size: var(--fs-sm); }

  .about-photo { margin: 0; }
  .photo-frame {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 0.5rem;
    background: var(--panel);
    box-shadow: var(--shadow);
  }
  .photo-frame img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    display: block;
    filter: saturate(1.05) contrast(1.02);
  }
  .photo-frame::after {
    content: '';
    position: absolute;
    inset: 0.5rem;
    border-radius: var(--radius);
    pointer-events: none;
    box-shadow: inset 0 0 60px -18px var(--glow);
  }
  .photo-tag {
    position: absolute;
    bottom: 0.9rem; left: 0.9rem;
    padding: 0.25rem 0.5rem;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--signal);
    backdrop-filter: blur(4px);
  }

  @media (max-width: 780px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-photo { max-width: 340px; }
  }
  @media (max-width: 460px) {
    .spec-row { grid-template-columns: 96px 1fr; gap: 0.75rem; }
    .spec-row dt { letter-spacing: 0.1em; }
  }
</style>
