---
import projects from '../data/projects.json';
const featured = projects.filter((p) => p.featured);
const grid = projects.filter((p) => !p.featured);
---
<section class="section" id="projects">
  <div class="container">
    <div class="sec-head">
      <span class="silk desig">03</span>
      <h2 class="sec-title">Featured work</h2>
    </div>

    <div class="featured">
      {featured.map((p, i) => (
        <article class={`feat reveal${i % 2 === 1 ? ' feat--flip' : ''}`}>
          <div class="feat-media">
            <div class="media-frame">
              {p.model ? (
                <div class="media-3d">
                  <model-viewer
                    src={p.model}
                    alt={p.title}
                    camera-controls
                    auto-rotate
                    loading="lazy"
                    reveal="auto"
                    camera-target="0.064m 0.004m 0.066m"
                    camera-orbit="35deg 68deg 0.215m"
                    min-camera-orbit="auto auto 0.1m"
                    max-camera-orbit="auto auto 1m"
                    field-of-view="30deg"
                    interaction-prompt="none"
                    environment-image="neutral"
                    shadow-intensity="1"
                    exposure="1.15"
                  ></model-viewer>
                </div>
              ) : (
                <img src={p.image} alt={p.title} loading="lazy" decoding="async" />
              )}
              <span class="silk media-tag">FIG.{i + 1}</span>
            </div>
          </div>
          <div class="feat-body">
            <span class="silk feat-status">{p.status}</span>
            <h3 class="feat-title">{p.title}</h3>
            <p class="feat-blurb">{p.blurb}</p>
            <p class="feat-detail">{p.detail}</p>
            {p.specs && (
              <dl class="feat-specs">
                {p.specs.map((s) => (
                  <div class="fs-row">
                    <dt class="mono">{s.k}</dt>
                    <dd class="mono">{s.v}</dd>
                  </div>
                ))}
              </dl>
            )}
            <div class="feat-foot">
              <ul class="tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>
              {p.links.length > 0 && (
                <div class="links">
                  {p.links.map((l) => (
                    <a class="btn" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="grid-divider" role="presentation"></div>
    <h3 class="silk grid-head"><span class="slash">//</span> more builds</h3>

    <div class="grid">
      {grid.map((p) => (
        <article class="card reveal">
          <div class="card-media">
            {p.model ? (
              <model-viewer
                src={p.model}
                alt={p.title}
                camera-controls
                auto-rotate
                loading="lazy"
                reveal="auto"
                camera-orbit="40deg 70deg auto"
                environment-image="neutral"
                shadow-intensity="1"
                exposure="1.15"
              ></model-viewer>
            ) : (
              <img src={p.image} alt={p.title} loading="lazy" decoding="async" />
            )}
          </div>
          <div class="card-body">
            <div class="card-top">
              <h4 class="card-title">{p.title}</h4>
              <span class="silk card-status">{p.status}</span>
            </div>
            <p class="card-blurb">{p.blurb}</p>
            <div class="card-foot">
              <ul class="tags">{p.tags.slice(0, 4).map((t) => <li class="tag">{t}</li>)}</ul>
              {p.links.length > 0 && (
                <div class="links">
                  {p.links.map((l) => (
                    <a class="card-link mono" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- model-viewer runtime: ~1MB, so only fetch it once the model nears the viewport -->
<script is:inline>
  (function () {
    var target = document.querySelector('model-viewer');
    if (!target) return;

    // don't spin the model for users who ask for reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var mvs = document.querySelectorAll('model-viewer[auto-rotate]');
      for (var j = 0; j < mvs.length; j++) mvs[j].removeAttribute('auto-rotate');
    }

    var loaded = false;
    function load() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement('script');
      s.type = 'module';
      s.src = 'https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js';
      document.head.appendChild(s);
    }

    if (!('IntersectionObserver' in window)) { load(); return; }
    var io = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) { load(); io.disconnect(); return; }
      }
    }, { rootMargin: '600px' });
    io.observe(target);
  })();
</script>

<style>
  /* ── Featured case studies ── */
  .featured { display: flex; flex-direction: column; gap: clamp(2.5rem, 6vw, 4.5rem); }
  .feat {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }
  .feat--flip .feat-media { order: 2; }

  .media-frame {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 0.5rem;
    background: var(--panel);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .media-frame img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
  }
  .media-frame::after {
    content: '';
    position: absolute; inset: 0.5rem;
    border-radius: var(--radius);
    pointer-events: none;
    box-shadow: inset 0 0 70px -22px var(--glow);
  }
  /* 3D model occupies exactly the same box as a featured image */
  .media-3d {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-1);
  }
  .media-3d model-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    --poster-color: transparent;
  }
  .media-tag {
    pointer-events: none;
    position: absolute;
    top: 0.85rem; left: 0.85rem;
    padding: 0.2rem 0.5rem;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--signal);
    backdrop-filter: blur(4px);
  }

  .feat-status { color: var(--text-mut); letter-spacing: 0.16em; }
  .feat-title {
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.55rem 0 0.75rem;
  }
  .feat-blurb {
    font-size: var(--fs-md);
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .feat-detail {
    color: var(--text-dim);
    margin-bottom: 1.25rem;
    max-width: 52ch;
  }

  .feat-specs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.15rem 1.25rem;
    padding: 0.9rem 1rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--panel) 45%, transparent);
  }
  .fs-row { display: flex; flex-direction: column; gap: 0.1rem; padding: 0.3rem 0; }
  .fs-row dt { font-size: 0.66rem; letter-spacing: 0.14em; color: var(--text-mut); }
  .fs-row dd { font-size: var(--fs-sm); color: var(--signal); }

  .feat-foot { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; }
  .feat-foot .links { display: flex; gap: 0.6rem; }
  .feat-foot .btn { padding: 0.5rem 0.9rem; }

  /* ── Divider + grid header ── */
  .grid-divider {
    height: 1px;
    margin: clamp(3rem, 7vw, 5rem) 0 1.5rem;
    background: var(--duo);
    opacity: 0.5;
  }
  .grid-head { color: var(--text-dim); margin-bottom: 1.5rem; }
  .grid-head .slash { color: var(--signal); }

  /* ── Compact grid ── */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--panel) 55%, transparent);
    overflow: hidden;
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease),
                box-shadow var(--dur) var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--signal) 40%, var(--line));
    box-shadow: 0 18px 40px -22px rgba(0,0,0,0.8), 0 0 0 1px color-mix(in srgb, var(--signal) 20%, transparent);
  }
  .card-media {
    height: 190px;
    background: var(--bg-1);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .card-media img { width: 100%; height: 100%; object-fit: cover; }
  .card-media model-viewer { width: 100%; height: 100%; --poster-color: transparent; }

  .card-body { padding: 1.1rem 1.15rem 1.25rem; display: flex; flex-direction: column; flex: 1; }
  .card-top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.5rem; }
  .card-title { font-size: var(--fs-md); font-weight: 600; }
  .card-status { color: var(--text-mut); letter-spacing: 0.12em; white-space: nowrap; }
  .card-blurb { color: var(--text-dim); font-size: var(--fs-sm); margin-bottom: 1rem; flex: 1; }
  .card-foot { display: flex; flex-direction: column; gap: 0.85rem; }
  .card-link { font-size: var(--fs-xs); color: var(--signal); letter-spacing: 0.04em; }
  .card-link:hover { color: var(--text); }

  @media (max-width: 760px) {
    .feat { grid-template-columns: 1fr; }
    .feat--flip .feat-media { order: 0; }
    .feat-specs { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 420px) {
    .feat-specs { grid-template-columns: 1fr; }
  }
</style>
